# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────
# Supabase — https://app.supabase.com → Project Settings → API
# Use the service_role key (bypasses RLS; safe for server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
# Authorized admin email(s), comma-separated if multiple
ADMIN_EMAIL=admin@internug.ug,nabandapriscilla@gmail.com

# Server
PORT=5000

# Email — Resend (https://resend.com)
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_your_resend_api_key

# From address — verify your domain at resend.com/domains first
# Until verified, use: InternUG <onboarding@resend.dev>  (test only)
EMAIL_FROM=InternUG <onboarding@resend.dev>
